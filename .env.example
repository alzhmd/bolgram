# ---------- Server ----------
# Domains for docker-compose + Caddy (automatic HTTPS): panel/API and the marketing site
DOMAIN=pay.example.com
SITE_DOMAIN=example.com
PORT=4000
NODE_ENV=production
# Public https address of this server (payment links, QR pairing, bot buttons)
PUBLIC_BASE_URL=https://pay.example.com
# Reverse proxy whose X-Forwarded-For is trusted. Empty = proxy on this machine (Caddy/Nginx on localhost).
# With docker-compose (Caddy in another container) use: TRUST_PROXY=172.16.0.0/12
TRUST_PROXY=

# ---------- Secrets (REQUIRED) ----------
# openssl rand -hex 32 — signs sessions; changing it logs everyone out
JWT_SECRET=
# openssl rand -hex 32 — card numbers are stored encrypted with this key; keep a backup and NEVER change it
CARD_ENC_KEY=
# Owner panel (/owner/) sign-in
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Storage ----------
DB_PATH=./data/bolgram.db
UPLOAD_DIR=./data/uploads

# ---------- Login codes (SMS.IR: Verify template with a parameter named CODE) ----------
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
SMSIR_PARAM_NAME=CODE
# true = merchants must confirm their mobile number before creating invoices
REQUIRE_MOBILE_VERIFY=false

# ---------- Matching ----------
# Unique amount: step in Rial (10 = 1 Toman) and max number of tails per price
UNIQUE_STEP=10
UNIQUE_MAX_TAILS=999
# Deposits from senders that are not official bank numbers are NOT auto-confirmed (fake SMS protection)
ALLOW_UNTRUSTED_SENDERS=false

# ---------- Telegram / Bale bot (optional) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Relay address when the server cannot reach api.telegram.org (servers inside Iran)
TELEGRAM_API_BASE=https://api.telegram.org
BALE_BOT_TOKEN=
BALE_BOT_USERNAME=
# Optional: also send every payment of the whole service to one owner chat
TELEGRAM_CHAT_ID=
BALE_CHAT_ID=
# polling (default, run ONE server instance) | webhook | off
BOT_MODE=polling
# webhook mode only: updates arrive at PUBLIC_BASE_URL/api/v1/bot/<platform>/<secret>
BOT_WEBHOOK_SECRET=

# ---------- Android app download shown in the panel ----------
ANDROID_APK_URL=
ANDROID_APK_SHA256=
ANDROID_APP_VERSION=
