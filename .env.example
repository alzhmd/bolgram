PORT=4000
HOST=0.0.0.0
NODE_ENV=production
# REQUIRED in production: signs login sessions and derives per-merchant webhook secrets.
# Generate with: openssl rand -hex 32   (changing it logs everyone out and rotates webhook secrets)
JWT_SECRET=
# Super admin login for /admin.html
ADMIN_EMAIL=
ADMIN_PASSWORD=
# SQLite file (default database; leave SUPABASE_* empty to use it)
DB_PATH=./data/bolgram.db
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Unique amount: step in Rial (10 = 1 Toman) and max number of tails per price
UNIQUE_STEP=10
UNIQUE_MAX_TAILS=999
# Deposits from senders that are not known bank numbers are NOT auto-confirmed (fake SMS protection)
ALLOW_UNTRUSTED_SENDERS=false

# Payment alerts (either or both). Bale works inside Iran.
BALE_BOT_TOKEN=
BALE_CHAT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Point to a relay if your server cannot reach api.telegram.org
TELEGRAM_API_BASE=https://api.telegram.org
