PORT=4000
HOST=0.0.0.0
NODE_ENV=production
# REQUIRED in production: signs login sessions and derives per-merchant webhook secrets.
# Generate with: openssl rand -hex 32   (changing it logs everyone out and rotates webhook secrets)
JWT_SECRET=
# Super admin login for /admin.html
ADMIN_EMAIL=
ADMIN_PASSWORD=
# SQLite file (default database; leave SUPABASE_* empty to use it)
DB_PATH=./data/bolgram.db
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Unique amount: step in Rial (10 = 1 Toman) and max number of tails per price
UNIQUE_STEP=10
UNIQUE_MAX_TAILS=999
# Deposits from senders that are not known bank numbers are NOT auto-confirmed (fake SMS protection)
ALLOW_UNTRUSTED_SENDERS=false

# Merchant bot + payment alerts (either or both). Bale works inside Iran.
# With a token set, the bot starts by itself: merchants link a chat from panel → «ربات تلگرام و بله».
# *_CHAT_ID (optional) also sends every payment of the whole service to one owner chat.
BALE_BOT_TOKEN=
BALE_BOT_USERNAME=
BALE_CHAT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=
# polling (default, no public address needed; run ONE server instance) | webhook | off
BOT_MODE=polling
# webhook mode only: random string; updates arrive at PUBLIC_BASE_URL/api/v1/bot/<platform>/<secret>
BOT_WEBHOOK_SECRET=
# Public https address of this server; used for payment links and buttons in the bot
PUBLIC_BASE_URL=
# Point to a relay if your server cannot reach api.telegram.org
TELEGRAM_API_BASE=https://api.telegram.org

# Login codes over SMS.IR (panel → Developer → API key; Verify template with a parameter named CODE)
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
SMSIR_PARAM_NAME=CODE
# true = merchant must confirm the mobile number before creating invoices
REQUIRE_MOBILE_VERIFY=false
# 64 hex chars (openssl rand -hex 32). Card numbers are stored encrypted with this key; keep it safe and never change it
CARD_ENC_KEY=
