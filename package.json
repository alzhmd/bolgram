{
  "name": "bolgram",
  "version": "1.2.0",
  "description": "بولگرام — درگاه پرداخت کارت‌به‌کارت با تأیید خودکار پیامک بانکی",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --test --test-concurrency=1 --import tsx tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "node --import tsx scripts/e2e-flow.mts"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^8.1.1",
    "dayjs": "^1.11.23",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^4.0.2",
    "qrcode": "^1.5.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@grammyjs/types": "5.0.0",
    "@types/node": "^22.13.5",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
