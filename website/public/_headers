/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://pay.bolgram.example; font-src 'self'; connect-src 'self' https://pay.bolgram.example; frame-ancestors 'none'; base-uri 'self'; form-action 'self' mailto:
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/assets/content/*
  Cache-Control: no-cache
/assets/js/config.js
  Cache-Control: no-cache
